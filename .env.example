# Copy to .env.local for development. Never commit real secrets.
# Public URL is also baked into the build; rebuild when it changes.
APP_URL=http://localhost:3000
DATA_DIR=./.data
CHROMIUM_PATH=/usr/local/bin/chromium

# Required for AI reviews. Use a key with access to the selected models.
OPENAI_API_KEY=
AI_MODEL_EVAL=gpt-6-luna
AI_EVAL_RUNS=3
AI_EVAL_REASONING=low
AI_MODEL_WRITE=gpt-6.1-terra
# Business plan default for a tiny launch budget: about 50 reviews a day. Reaching it pauses free
# accounts and the free grader until midnight UTC; paying customers carry on. Raise it as customers
# arrive (~$0.30/day per Agency customer).
AI_DAILY_BUDGET_USD=1
# Hard stop: reaching it pauses every review, paying customers' too. Default: three times the budget
# (never below it), so leave it unset unless you want a different ceiling.
#AI_DAILY_HARD_CAP_USD=3
PERFORMANCE_AUDIT=on
PAGESPEED_API_KEY=

# Stripe test keys for development; live keys only on production.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Production email: SMTP, verification, password resets and notifications.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM="PageGrade <pagegrade1@gmail.com>"
SUPPORT_EMAIL=pagegrade1@gmail.com
# Default: true if SMTP_HOST is set, false otherwise.
REQUIRE_EMAIL_VERIFICATION=true

# Comma-separated account emails allowed into /admin.
ADMIN_EMAILS=
COMPANY_NUMBER=
COMPANY_ADDRESS=
WORKER_CONCURRENCY=1
REVIEW_TIMEOUT_MS=540000
SHUTDOWN_GRACE_MS=25000
TRUST_PROXY_HOPS=1
RUN_WORKER=true

# Free grader (no sign-up): grades per visitor per day, and in total per day (plan default: 20 while the budget is tiny)
FREE_GRADER_PER_IP=3
FREE_GRADER_DAILY_LIMIT=20
# Partner programme
REFERRAL_PERCENT=30
REFERRAL_MONTHS=12
REFERRAL_PAYOUT_MIN_GBP=50
# PDF export: address the web process uses to open its own print page (default http://127.0.0.1:$PORT)
#INTERNAL_APP_URL=
# Your name, used in emails
FOUNDER_NAME=
# Where sign-up alerts, prospect-pack requests and the Monday digest are sent (default: first ADMIN_EMAILS entry)
FOUNDER_ALERT_EMAIL=
# Public booking link for the 15-minute agency call (Cal.com is free). Read at runtime; /agencies picks up a change within an hour.
NEXT_PUBLIC_BOOKING_URL=
