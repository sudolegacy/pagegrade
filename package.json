{
  "name": "pagegrade",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:worker": "tsx watch src/worker/main.ts",
    "build": "next build && npm run build:worker",
    "build:worker": "esbuild src/worker/main.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outfile=dist/worker.mjs --tsconfig=tsconfig.json",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "bench": "tsx --env-file=.env.local bench/run.ts",
    "stripe:setup": "tsx scripts/setup-stripe.ts"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "better-sqlite3": "^13.0.3",
    "chrome-launcher": "^1.2.3",
    "clsx": "^2.1.1",
    "geist": "^1.9.1",
    "lighthouse": "^13.6.0",
    "lucide-react": "^1.69.0",
    "marked": "^18.1.3",
    "next": "^15.5.29",
    "nodemailer": "^10.3.1",
    "openai": "^7.52.0",
    "playwright-core": "^1.65.0",
    "react": "19.2",
    "react-dom": "19.2",
    "sharp": "^0.35.5",
    "stripe": "^23.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.32"
    }
  }
}
